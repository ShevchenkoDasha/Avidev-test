    "firebase": "^12.10.0",
    "formik": "^2.4.9",
    "i18next": "^25.8.18",
    "lodash": "^4.17.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "yup": "^1.7.1"
